{
  "name": "harttlink",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write src index.html package.json tsconfig.json",
    "format:check": "prettier --check src index.html package.json tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
